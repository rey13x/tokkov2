# Safe Vercel environment template.
# Fill secret values in Vercel Dashboard. Do not commit private keys or tokens.

NEXTAUTH_URL=https://www.tokkomarketplace.shop
NEXTAUTH_SECRET=<generate-a-new-random-secret>

# Firebase client config for tokkoV2-a4603
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBZlLo9_d9t3VMzxeSSO6dPcnwPfYU4LRU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tokkov2-a4603.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tokkov2-a4603
NEXT_PUBLIC_FIREBASE_APP_ID=1:916208995900:web:4cea547611e7dc8b273d39
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=916208995900
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tokkov2-a4603.firebasestorage.app
NEXT_PUBLIC_FIREBASE_VAPID_KEY=<get-from-new-firebase-project>

# Firebase Admin: create a NEW service account in tokkoV2-a4603.
# Do not reuse a private key from any retired Firebase project.
FIREBASE_SERVICE_ACCOUNT_JSON=<new-project-service-account-json>
# Or use all of these instead:
FIREBASE_PROJECT_ID=tokkov2-a4603
FIREBASE_CLIENT_EMAIL=<new-service-account-email>
FIREBASE_PRIVATE_KEY=<new-service-account-private-key>
FIREBASE_PRIVATE_KEY_ID=<new-private-key-id>
