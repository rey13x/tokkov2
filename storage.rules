rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isMedia() {
      return request.resource.contentType.matches('(image|video|audio)/.*');
    }

    function validSize(maxBytes) {
      return request.resource.size < maxBytes;
    }

    // Public web assets. Admin uploads only.
    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isMedia() && validSize(25 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /assets/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isMedia() && validSize(25 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /profile-photos/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && isImage() && validSize(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /story-media/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && isMedia() && validSize(50 * 1024 * 1024);
      allow delete: if signedIn();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isMedia() && validSize(100 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    // Receipt files should be served through server-generated signed URLs.
    match /receipts/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
